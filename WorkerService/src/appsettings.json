{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "http://localhost:8080"
    },
    "SyncConfiguration": {
      "SyncIntervalMinutes": 60,
      "HealthCheckIntervalMinutes": 5,
      "EnableScheduledSync": false
    },
    "StorageConfiguration": {
      "MetadataPath": "./data/metadata",
      "ContentPath": "./data/content",
      "UseAzureStorageForMetadata": false,
      "UseAzureStorageForContent": false
    },
    "CacheConfiguration": {
      "EnableDistributedCache": true,
      "RedisConnectionString": "localhost:6379",
      "KeyPrefix": "updateengine",
      "InvalidateOnSync": true,
      "DefaultTtlMinutes": 60
    },
    "FeatureFlags": {
      "EnableComprehensiveSync": true,
      "EnableContentSync": true,
      "EnableCaching": true,
      "EnableDetailedLogging": false
    }
  }
}
