<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Project-specific properties only -->
    <RootNamespace>UpdateEngine.UpstreamSource</RootNamespace>
    <AssemblyName>UpdateEngine.UpstreamSource</AssemblyName>
    <PackageId>Microsoft.PackageGraph.MicrosoftUpdate.Sources</PackageId>
    <Description>Implements sources for the MicrosoftUpdate partition of a package graph. Provides an implementation of the server-server sync protocol between a client and an upstream Microsoft Update server.</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DocumentationFile>$(BaseOutputPath)documentation\xml-autogenerated\microsoft-update-upstream-source.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Query\**" />
    <EmbeddedResource Remove="Query\**" />
    <None Remove="Query\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UpdateEngine.Metadata\src\microsoft-update-partition.csproj" />
    <ProjectReference Include="..\..\UpdateEngine.WebServices\src\microsoft-update-webservices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WCFMetadata Include="Connected Services" />
  </ItemGroup>

</Project>
