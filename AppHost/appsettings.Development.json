{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Dashboard": {
        "Otlp": {
            "AuthMode": "Unsecured"
        }
    },
    "Storage": {
        "UseAzureStorage": true,
        "MetadataStorePath": "./store",
        "ContentStorePath": "./content",
        "MetadataContainerName": "metadata",
        "ContentContainerName": "content"
    },
    "Service": {
        "ServiceUrl": "http://localhost:7071",
        "MaxUpdateCount": 100,
        "SupportedCategories": [
            "Security Updates",
            "Critical Updates",
            "Feature Packs",
            "Updates",
            "Drivers"
        ]
    },
    "Sync": {
        "CriticalUpdatesIntervalHours": 4,
        "ComprehensiveUpdatesIntervalHours": 24,
        "ContentSyncIntervalHours": 168,
        "MaintenanceIntervalHours": 168,
        "HealthCheckIntervalMinutes": 60
    },
    "Features": {
        "EnableScheduledSync": true,
        "EnableContentSync": true,
        "EnableHealthMonitoring": true,
        "EnableMetadataExport": true,
        "EnableDriverMatching": true,
        "ReindexOnStartup": false
    }
}
