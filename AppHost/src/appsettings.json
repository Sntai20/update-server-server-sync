{
  "UpdateServer": {
    "ServiceUrl": "http://localhost:7071",
    "ContentUrl": "http://localhost:7071/api/content",
    "MaxUpdateCount": 1000,
    "SupportedCategories": [
      "Security Updates",
      "Critical Updates",
      "Feature Packs",
      "Updates",
      "Drivers"
    ]
  },
  "Storage": {
    "MetadataPath": "./store",
    "ContentPath": "./content",
    "UseAzureStorageForMetadata": true,
    "UseAzureStorageForContent": true,
    "MetadataContainerName": "data",
    "ContentContainerName": "data",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "00:02:00",
    "SyncComprehensive": "00:05:00",
    "SyncContent": "1.00:00:00",
    "HealthCheck": "00:15:00",
    "WeeklyMaintenance": "7.00:00:00"
  },
  "AzureWebJobs": {
    // === CORE SYNC FUNCTIONS ===
    "UniversalSync": {
      "Disabled": false
    },
    "SyncCritical": {
      "Disabled": false
    },
    "SyncComprehensive": {
      "Disabled": true
    },
    "SyncContent": {
      "Disabled": false
    },

    // === HEALTH & MONITORING ===
    "UniversalHealth": {
      "Disabled": false
    },
    "ScheduledHealthCheck": {
      "Disabled": false
    },
    "WeeklyMaintenance": {
      "Disabled": true
    },
    "StoreManagement": {
      "Disabled": false
    },
    "CheckReindexRequired": {
      "Disabled": false
    },

    // === QUERY & METADATA FUNCTIONS ===
    "QueryAvailableFilters": {
      "Disabled": false
    },
    "QueryContentStatus": {
      "Disabled": false
    },
    "QueryMetadata": {
      "Disabled": false
    },
    "QueryMetadataStoreStatus": {
      "Disabled": false
    },
    "StorageDiagnostics": {
      "Disabled": false
    },

    // === CONTENT SERVING ===
    "GetMicrosoftUpdateContent": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContentHead": {
      "Disabled": true
    },

    // === DISABLED WEB SERVICES ===
    "ClientWebService": {
      "Disabled": true
    },
    "DssAuthWebService": {
      "Disabled": true
    },
    "ReportingWebService": {
      "Disabled": true
    },
    "ServerSyncWebService": {
      "Disabled": true
    },
    "SimpleAuthWebService": {
      "Disabled": true
    },

    // === DISABLED OPTIONAL FUNCTIONS ===
    "ExportMetadata": {
      "Disabled": true
    },
    "MatchDrivers": {
      "Disabled": true
    },
    "ProcessContentSyncRequest": {
      "Disabled": true
    },
    "ProcessPrioritySyncRequest": {
      "Disabled": true
    },
    "ProcessStandardSyncRequest": {
      "Disabled": true
    },
    "ProcessUniversalSyncRequest": {
      "Disabled": true
    },cheduledSyncFull": {
      "Disabled": true
    }
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": true,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": true,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 2,
    "ComprehensiveUpdatesIntervalHours": 24,
    "ContentSyncIntervalHours": 72,
    "HealthCheckIntervalMinutes": 15,
    "MaintenanceIntervalHours": 168
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
