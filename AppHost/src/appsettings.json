        "StorageDiagnostics": {
            "Disabled": false
        },
        "SyncComprehensiveUpdates": {
            "Disabled": true
        },
        "SyncContent": {
            "Disabled": false
        },
        "SyncCriticalUpdates": {
            "Disabled": true
        }
    },
    "Features": {
        "EnableContentSync": true,
        "EnableDriverMatching": true,
        "EnableHealthMonitoring": true,
        "EnableMetadataExport": true,
        "EnableScheduledSync": true,
        "ReindexOnStartup": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Service": {
        "MaxUpdateCount": 1000,
        "ServiceUrl": "http://localhost:7071",
        "SupportedCategories": [
            "Security Updates",
            "Critical Updates",
            "Feature Packs",
            "Updates",
            "Drivers"
        ]
    },
    "Storage": {
        "ContentContainerName": "data",
        "ContentStorePath": "./content",
        "MetadataContainerName": "data",
        "MetadataStorePath": "./store",
        "UseAzureStorageForMetadata": false,
        "UseAzureStorageForContent": false
    },
    "Sync": {
        "ComprehensiveUpdatesIntervalHours": 24,
        "ContentSyncIntervalHours": 168,
        "CriticalUpdatesIntervalHours": 4,
        "HealthCheckIntervalMinutes": 60,
        "MaintenanceIntervalHours": 168
    },
    "FunctionSchedules": {
        "HourlyHealthCheckSchedule": "01:00:00",
        "DailyCriticalSyncSchedule": "1.00:00:00",
        "WeeklyComprehensiveSyncSchedule": "7.00:00:00",
        "MonthlyMaintenanceSchedule": "30.00:00:00",
        "ScheduledHealthCheckSchedule": "01:00:00",
        "WeeklyMaintenanceSchedule": "7.00:00:00",
        "SyncMetadataComprehensiveSchedule": "1.00:00:00",
        "SyncMetadataCriticalSchedule": "04:00:00",
        "SyncContentSchedule": "7.00:00:00"
    }
}