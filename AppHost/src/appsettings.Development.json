        },
        "ExportMetadata": {
            "Disabled": true
        },
        "GetContentStatus": {
            "Disabled": false
        },
        "GetStoreStatus": {
            "Disabled": false
        },
        "GetUpdateContent": {
            "Disabled": true
        },
        "GetUpdateMetadata": {
            "Disabled": true
        },
        "HealthCheck": {
            "Disabled": true
        },
        "Maintenance": {
            "Disabled": true
        },
        "MatchDrivers": {
            "Disabled": true
        },
        "ProcessContentSyncRequest": {
            "Disabled": true
        },
        "ProcessPrioritySyncRequest": {
            "Disabled": true
        },
        "ProcessStandardSyncRequest": {
            "Disabled": true
        },
        "QueryMetadata": {
            "Disabled": false
        },
        "ReportingWebService": {
            "Disabled": true
        },
        "ServerWebService": {
            "Disabled": true
        },
        "SimpleAuthWebService": {
            "Disabled": true
        },
        "StorageDiagnostics": {
            "Disabled": false
        },
        "SyncComprehensiveUpdates": {
            "Disabled": true
        },
        "SyncContent": {
            "Disabled": false
        },
        "SyncCriticalUpdates": {
            "Disabled": true
        }
    },
    "Features": {
        "EnableContentSync": true,
        "EnableDriverMatching": false,
        "EnableHealthMonitoring": false,
        "EnableMetadataExport": false,
        "EnableScheduledSync": false,
        "ReindexOnStartup": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Service": {
        "MaxUpdateCount": 10,
        "ServiceUrl": "http://localhost:7071",
        "SupportedCategories": [
            "Security Updates",
            "Critical Updates"
        ]
    },
    "Storage": {
        "ContentContainerName": "data",
        "ContentStorePath": "./content",
        "MetadataContainerName": "data",
        "MetadataStorePath": "./store",
        "UseAzureStorage": true
    },
    "Sync": {
        "ComprehensiveUpdatesIntervalHours": 24,
        "ContentSyncIntervalHours": 168,
        "CriticalUpdatesIntervalHours": 4,
        "HealthCheckIntervalMinutes": 60,
        "MaintenanceIntervalHours": 168
    },
    "FunctionSchedules": {
        "HourlyHealthCheckSchedule": "02:00:00",
        "DailyCriticalSyncSchedule": "2.00:00:00",
        "WeeklyComprehensiveSyncSchedule": "14.00:00:00",
        "MonthlyMaintenanceSchedule": "30.00:00:00",
        "ScheduledHealthCheckSchedule": "02:00:00",
        "WeeklyMaintenanceSchedule": "14.00:00:00",
        "ScheduledMetadataSyncSchedule": "2.00:00:00",
        "CriticalUpdatesSyncSchedule": "08:00:00",
        "ScheduledContentSyncSchedule": "14.00:00:00"
    }
}