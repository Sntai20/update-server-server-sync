{
  "UpdateServer": {
    "ServiceUrl": "http://localhost:7071",
    "ContentUrl": "http://localhost:7071/api/content",
    "MaxUpdateCount": 5,
    "SupportedCategories": ["Security Updates", "Critical Updates"]
  },
  "Storage": {
    "MetadataPath": "./localMetadataStore",
    "ContentPath": "./localContentStore",
    "UseAzureStorageForMetadata": true,
    "UseAzureStorageForContent": true,
    "MetadataContainerName": "data",
    "ContentContainerName": "data",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "00:02:00",
    "SyncComprehensive": "00:05:00", 
    "SyncContent": "00:03:00",
    "HealthCheck": "00:01:00",
    "WeeklyMaintenance": "14.00:00:00",
    "AnomalyDetection": "00:02:00"
  },
  "AzureWebJobs": {
    "UniversalSync": {
      "Disabled": false
    },
    "SyncCritical": {
      "Disabled": false
    },
    "SyncComprehensive": {
      "Disabled": true
    },
    "SyncContent": {
      "Disabled": false
    },
    "UniversalHealth": {
      "Disabled": false
    },
    "ScheduledHealthCheck": {
      "Disabled": false
    },
    "WeeklyMaintenance": {
      "Disabled": true
    },
    "StoreManagement": {
      "Disabled": false
    },
    "CheckReindexRequired": {
      "Disabled": false
    },
    "QueryAvailableFilters": {
      "Disabled": false
    },
    "QueryContentStatus": {
      "Disabled": false
    },
    "QueryMetadata": {
      "Disabled": false
    },
    "QueryMetadataStoreStatus": {
      "Disabled": false
    },
    "StorageDiagnostics": {
      "Disabled": false
    },
    "GetMicrosoftUpdateContent": {
      "Disabled": false
    },
    "GetMicrosoftUpdateContentHead": {
      "Disabled": false
    },
    "ClientWebService": {
      "Disabled": true
    },
    "DssAuthWebService": {
      "Disabled": true
    },
    "ReportingWebService": {
      "Disabled": true
    },
    "ServerSyncWebService": {
      "Disabled": true
    },
    "SimpleAuthWebService": {
      "Disabled": true
    },
    "ExportMetadata": {
      "Disabled": true
    },
    "MatchDrivers": {
      "Disabled": true
    },
    "ProcessContentSyncRequest": {
      "Disabled": true
    },
    "ProcessPrioritySyncRequest": {
      "Disabled": true
    },
    "ProcessStandardSyncRequest": {
      "Disabled": true
    },
    "ProcessUniversalSyncRequest": {
      "Disabled": true
    },
    "ScheduledSyncFull": {
      "Disabled": true
    },
    "IngestAnomaly": {
      "Disabled": false
    },
    "ProcessAnomalyQueue": {
      "Disabled": false
    },
    "ScheduledAnomalyDetection": {
      "Disabled": false
    },
    "TrainAnomalyModel": {
      "Disabled": true
    }
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": false,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false,
    "EnableAnomalyDetection": true
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 2,
    "ComprehensiveUpdatesIntervalHours": 5,
    "ContentSyncIntervalHours": 3,
    "HealthCheckIntervalMinutes": 1,
    "MaintenanceIntervalHours": 336,
    "AnomalyDetectionIntervalMinutes": 2
  },
  "AnomalyDetection": {
    "ModelPath": "./anomaly-model.zip",
    "QueueName": "anomaly-events",
    "TrainingDataPath": "./training-data",
    "MinTrainingDataSize": 1000,
    "AnomalyScoreThreshold": 0.85,
    "Features": {
      "FileSize": { "Weight": 1.0, "Normalize": true },
      "IsSigned": { "Weight": 1.5, "Normalize": false },
      "DomainReputation": { "Weight": 2.0, "Normalize": true },
      "HashMatch": { "Weight": 2.5, "Normalize": false },
      "UpdateFrequency": { "Weight": 1.0, "Normalize": true }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine.Services.AnomalyDetectionService": "Debug",
      "UpdateEngine.Functions.AnomalyDetectionFunctions": "Information"
    }
  }
}
