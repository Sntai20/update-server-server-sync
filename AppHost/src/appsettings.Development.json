{
  "UpdateServer": {
    "ServiceUrl": "http://localhost:7071",
    "ContentUrl": "http://localhost:7071/api/content",
    "MaxUpdateCount": 5,
    "SupportedCategories": ["Security Updates", "Critical Updates", "Definition Updates"],
    "SupportedProducts": ["Windows 11", "Windows 10"],
    "SupportedLanguages": ["en", "en-US", "neutral", ""]
  },
  "Storage": {
    "MetadataPath": "./localMetadataStore",
    "ContentPath": "./localContentStore",
    "UseAzureStorageForMetadata": true,
    "UseAzureStorageForContent": true,
    "MetadataContainerName": "data",
    "ContentContainerName": "data",
    "ContentPathPrefix": "Content",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "00:00:30",
    "SyncComprehensive": "00:02:00", 
    "SyncContent": "00:01:00",
    "HealthCheck": "00:00:15",
    "WeeklyMaintenance": "14.00:00:00",
    "AnomalyDetection": "00:00:30"
  },
  "AzureWebJobs": {
    "UniversalSync": {
      "Disabled": false
    },
    "SyncCritical": {
      "Disabled": true
    },
    "SyncComprehensive": {
      "Disabled": true
    },
    "SyncContent": {
      "Disabled": true
    },
    "UniversalHealth": {
      "Disabled": false
    },
    "ScheduledHealthCheck": {
      "Disabled": true
    },
    "WeeklyMaintenance": {
      "Disabled": true
    },
    "StoreManagement": {
      "Disabled": false
    },
    "CheckReindexRequired": {
      "Disabled": false
    },
    "QueryAvailableFilters": {
      "Disabled": false
    },
    "QueryContentStatus": {
      "Disabled": false
    },
    "QueryMetadata": {
      "Disabled": false
    },
    "QueryMetadataStoreStatus": {
      "Disabled": false
    },
    "StorageDiagnostics": {
      "Disabled": false
    },
    "GetMicrosoftUpdateContent": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContentHead": {
      "Disabled": true
    },
    "ClientWebService": {
      "Disabled": true
    },
    "DssAuthWebService": {
      "Disabled": true
    },
    "ReportingWebService": {
      "Disabled": true
    },
    "ServerSyncWebService": {
      "Disabled": true
    },
    "SimpleAuthWebService": {
      "Disabled": true
    },
    "ExportMetadata": {
      "Disabled": false
    },
    "MatchDrivers": {
      "Disabled": true
    },
    "ProcessContentSyncRequest": {
      "Disabled": true
    },
    "ProcessPrioritySyncRequest": {
      "Disabled": true
    },
    "ProcessStandardSyncRequest": {
      "Disabled": true
    },
    "ProcessUniversalSyncRequest": {
      "Disabled": true
    },
    "ScheduledSyncFull": {
      "Disabled": true
    },
    "IngestAnomaly": {
      "Disabled": false
    },
    "ProcessAnomalyQueue": {
      "Disabled": false
    },
    "ScheduledAnomalyDetection": {
      "Disabled": false
    },
    "TrainAnomalyModel": {
      "Disabled": true
    }
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": false,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": true,
    "EnableScheduledSync": false,
    "ReindexOnStartup": false,
    "EnableAnomalyDetection": true
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 0.5,
    "ComprehensiveUpdatesIntervalHours": 2,
    "ContentSyncIntervalHours": 1,
    "HealthCheckIntervalMinutes": 0.25,
    "MaintenanceIntervalHours": 336,
    "AnomalyDetectionIntervalMinutes": 0.5
  },
  "AnomalyDetection": {
    "ModelPath": "./anomaly-model.zip",
    "QueueName": "anomaly-events",
    "TrainingDataPath": "./training-data",
    "MinTrainingDataSize": 1000,
    "AnomalyScoreThreshold": 0.85,
    "Features": {
      "FileSize": { "Weight": 1.0, "Normalize": true },
      "IsSigned": { "Weight": 1.5, "Normalize": false },
      "DomainReputation": { "Weight": 2.0, "Normalize": true },
      "HashMatch": { "Weight": 2.5, "Normalize": false },
      "UpdateFrequency": { "Weight": 1.0, "Normalize": true }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine.Services.AnomalyDetectionService": "Debug",
      "UpdateEngine.Functions.AnomalyDetectionFunctions": "Information",
      "Microsoft.PackageGraph": "Debug",
      "Microsoft.PackageGraph.Storage": "Debug",
      "Microsoft.PackageGraph.Storage.Azure": "Debug",
      "Microsoft.PackageGraph.Storage.Azure.BlobContentStore": "Trace",
      "Microsoft.PackageGraph.MicrosoftUpdate": "Debug",
      "Microsoft.PackageGraph.Endpoints": "Debug",
      "UpdateEngine.Services.StorageService": "Debug",
      "UpdateEngine.Services.ServiceCollectionExtensions": "Debug",
      "Azure.Storage.Blobs": "Debug",
      "Azure.Core": "Information"
    }
  }
}
