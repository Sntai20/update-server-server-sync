{
  "AzureWebJobs": {
    // === NEW UNIFIED FUNCTIONS ===
    "UniversalSync": {
      "Disabled": false
    },
    "ScheduledSyncCritical": {
      "Disabled": false
    },
    "ScheduledSyncComprehensive": {
      "Disabled": true
    },
    "ScheduledSyncContent": {
      "Disabled": false
    },
    "ScheduledSyncFull": {
      "Disabled": true
    },
    "ProcessUniversalSyncRequest": {
      "Disabled": true
    },
    "UniversalHealth": {
      "Disabled": false
    },
    "ScheduledHealthMonitoring": {
      "Disabled": false
    },
    "ScheduledMaintenance": {
      "Disabled": true
    },
    "ScheduledMaintenanceMonthly": {
      "Disabled": true
    },
    "StoreManagement": {
      "Disabled": false
    },
    "CheckReindexRequired": {
      "Disabled": false
    },
    "QueryContentStatus": {
      "Disabled": false
    },

    // === KEEP UNIQUE FUNCTIONS ===
    "ClientWebService": {
      "Disabled": true
    },
    "DssAuthWebService": {
      "Disabled": true
    },
    "ExportMetadata": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContent": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContentHead": {
      "Disabled": true
    },
    "MatchDrivers": {
      "Disabled": true
    },
    "QueryAvailableFilters": {
      "Disabled": false
    },
    "QueryMetadata": {
      "Disabled": false
    },
    "QueryMetadataStoreStatus": {
      "Disabled": false
    },
    "ReportingWebService": {
      "Disabled": true
    },
    "ServerSyncWebService": {
      "Disabled": true
    },
    "SimpleAuthWebService": {
      "Disabled": true
    },
    "StorageDiagnostics": {
      "Disabled": false
    },

    // === DISABLE OLD DUPLICATE FUNCTIONS ===
    "SyncContent": {
      "Disabled": true
    },
    "SyncMetadata": {
      "Disabled": true
    },
    "SyncHealth": {
      "Disabled": true
    },
    "HealthCheck": {
      "Disabled": true
    },

    // === ADD ML.NET ANOMALY DETECTION FUNCTIONS ===
    "IngestAnomaly": {
      "Disabled": false
    },
    "ProcessAnomalyQueue": {
      "Disabled": false
    },
    "TrainAnomalyModel": {
      "Disabled": true  // Manual trigger only
    }
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": false,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false,
    "EnableAnomalyDetection": true,
    "EnableAnomalyModelTraining": false
  },
  "FunctionSchedules": {
    "SyncMetadataCriticalSchedule": "00:05:00",
    "SyncMetadataComprehensiveSchedule": "00:10:00",
    "SyncContentSchedule": "00:05:00",
    "WeeklyComprehensiveSyncSchedule": "14.00:00:00",
    "ScheduledHealthCheckSchedule": "02:00:00",
    "WeeklyMaintenanceSchedule": "14.00:00:00",
    "MonthlyMaintenanceSchedule": "30.00:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine.Services.AnomalyDetectionService": "Debug",
      "UpdateEngine.Functions.AnomalyDetectionFunctions": "Information"
    }
  },
  "Service": {
    "MaxUpdateCount": 10,
    "ServiceUrl": "http://localhost:7071",
    "SupportedCategories": ["Security Updates", "Critical Updates"]
  },
  "Storage": {
    "ContentContainerName": "data",
    "ContentStorePath": "./localContentStore",
    "MetadataContainerName": "data",
    "MetadataStorePath": "./localMetadataStore",
    "UseAzureStorageForContent": false,
    "UseAzureStorageForMetadata": false
  },
  "Sync": {
    "ComprehensiveUpdatesIntervalHours": 24,
    "ContentSyncIntervalHours": 168,
    "CriticalUpdatesIntervalHours": 4,
    "HealthCheckIntervalMinutes": 60,
    "MaintenanceIntervalHours": 168
  },
  "AnomalyDetection": {
    "ModelPath": "./anomaly-model.zip",
    "QueueName": "anomaly-events",
    "TrainingDataPath": "./training-data",
    "MinTrainingDataSize": 1000,
    "AnomalyScoreThreshold": 0.85,
    "Features": {
      "FileSize": { "Weight": 1.0, "Normalize": true },
      "IsSigned": { "Weight": 1.5, "Normalize": false },
      "DomainReputation": { "Weight": 2.0, "Normalize": true },
      "HashMatch": { "Weight": 2.5, "Normalize": false },
      "UpdateFrequency": { "Weight": 1.0, "Normalize": true }
    }
  }
}
