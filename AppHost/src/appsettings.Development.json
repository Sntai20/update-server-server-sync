{
  "ServiceUrl": "http://localhost:7071",
  "ContentUrl": "http://localhost:7071/api/content", 
  "MaxUpdateCount": 5,
  "SupportedCategories": ["Security Updates", "Critical Updates", "Definition Updates"],
  "SupportedLanguages": ["en", "en-US", "neutral", ""],

  "MetadataPath": "./dev-store",
  "ContentPath": "./dev-content",
  "UseAzureStorageForMetadata": true,
  "UseAzureStorageForContent": true,
  "MetadataContainerName": "dev-metadata",
  "ContentContainerName": "dev-content",
  "ReindexOnStartup": true,

  "SyncCriticalSchedule": "00:00:30",
  "SyncComprehensiveSchedule": "00:02:00",
  "SyncContentSchedule": "00:01:00",
  "HealthCheckSchedule": "00:00:15",
  "MaintenanceSchedule": "14.00:00:00",
  "WeeklyMaintenanceSchedule": "14.00:00:00",
  "AnomalyDetectionSchedule": "00:00:30",

  "EnableScheduledSync": false,
  "EnableDetailedLogging": true,
  "EnableMetrics": false,
  "EnableCaching": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.PackageGraph": "Debug",
      "UpdateEngine.Services": "Debug"
    }
  }
}
