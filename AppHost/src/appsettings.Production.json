        },
        "ExportMetadata": {
            "Disabled": true
        },
        "GetContentStatus": {
            "Disabled": false
        },
        "GetStoreStatus": {
            "Disabled": false
        },
        "GetUpdateContent": {
            "Disabled": true
        },
        "GetUpdateMetadata": {
            "Disabled": true
        },
        "HealthCheck": {
            "Disabled": true
        },
        "Maintenance": {
            "Disabled": true
        },
        "MatchDrivers": {
            "Disabled": true
        },
        "ProcessContentSyncRequest": {
            "Disabled": true
        },
        "ProcessPrioritySyncRequest": {
            "Disabled": true
        },
        "ProcessStandardSyncRequest": {
            "Disabled": true
        },
        "QueryMetadata": {
            "Disabled": false
        },
        "ReportingWebService": {
            "Disabled": true
        },
        "ServerWebService": {
            "Disabled": true
        },
        "SimpleAuthWebService": {
            "Disabled": true
        },
        "StorageDiagnostics": {
            "Disabled": false
        },
        "SyncComprehensiveUpdates": {
            "Disabled": true
        },
        "SyncContent": {
            "Disabled": false
        },
        "SyncCriticalUpdates": {
            "Disabled": true
        }
    },
    "Features": {
        "EnableContentSync": true,
        "EnableDriverMatching": true,
        "EnableHealthMonitoring": true,
        "EnableMetadataExport": false,
        "EnableScheduledSync": true,
        "ReindexOnStartup": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Error",
            "Microsoft.Hosting.Lifetime": "Warning"
        }
    },
    "Service": {
        "MaxUpdateCount": 10000,
        "ServiceUrl": "https://your-app.azurewebsites.net",
        "SupportedCategories": [
            "Security Updates",
            "Critical Updates",
            "Feature Packs",
            "Updates",
            "Drivers"
        ]
    },
    "Storage": {
        "ContentContainerName": "content",
        "ContentStorePath": "./content",
        "MetadataContainerName": "metadata",
        "MetadataStorePath": "./store",
        "UseAzureStorageForMetadata": true,
        "UseAzureStorageForContent": true
    },
    "Sync": {
        "ComprehensiveUpdatesIntervalHours": 24,
        "ContentSyncIntervalHours": 168,
        "CriticalUpdatesIntervalHours": 6,
        "HealthCheckIntervalMinutes": 15,
        "MaintenanceIntervalHours": 168
    },
    "FunctionSchedules": {
        "HourlyHealthCheckSchedule": "00:15:00",
        "DailyCriticalSyncSchedule": "1.00:00:00",
        "WeeklyComprehensiveSyncSchedule": "7.00:00:00",
        "MonthlyMaintenanceSchedule": "30.00:00:00",
        "ScheduledHealthCheckSchedule": "00:15:00",
        "WeeklyMaintenanceSchedule": "7.00:00:00",
        "ScheduledMetadataSyncSchedule": "1.00:00:00",
        "CriticalUpdatesSyncSchedule": "06:00:00",
        "ScheduledContentSyncSchedule": "7.00:00:00"
    }
}