  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": true,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncMetadataCriticalSchedule": "06:00:00",
    "SyncMetadataComprehensiveSchedule": "1.00:00:00",
    "SyncContentSchedule": "7.00:00:00",
    "WeeklyComprehensiveSyncSchedule": "7.00:00:00",
    "ScheduledHealthCheckSchedule": "00:15:00",
    "WeeklyMaintenanceSchedule": "7.00:00:00",
    "MonthlyMaintenanceSchedule": "30.00:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Service": {
    "MaxUpdateCount": 10000,
    "ServiceUrl": "https://your-update-server.azurewebsites.net",
    "SupportedCategories": [
      "Security Updates",
      "Critical Updates",
      "Feature Packs",
      "Updates",
      "Drivers"
    ]
  },
  "Storage": {
    "ContentContainerName": "content",
    "ContentStorePath": "./content",
    "MetadataContainerName": "metadata",
    "MetadataStorePath": "./store",
    "UseAzureStorageForContent": true,
    "UseAzureStorageForMetadata": true
  },
  "Sync": {
    "ComprehensiveUpdatesIntervalHours": 24,
    "ContentSyncIntervalHours": 168,
    "CriticalUpdatesIntervalHours": 6,
    "HealthCheckIntervalMinutes": 15,
    "MaintenanceIntervalHours": 168
  }
