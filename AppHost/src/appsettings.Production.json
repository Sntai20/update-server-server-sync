{
  "AzureWebJobs": {
    "ClientWebService": { "Disabled": false },
    "ServerWebService": { "Disabled": false },
    "ReportingWebService": { "Disabled": false },
    "SimpleAuthWebService": { "Disabled": false },
    "DssAuthWebService": { "Disabled": false },
    "GetStoreStatus": { "Disabled": false },
    "GetUpdateMetadata": { "Disabled": false },
    "GetUpdateContent": { "Disabled": false },
    "SyncCriticalUpdates": { "Disabled": false },
    "SyncComprehensiveUpdates": { "Disabled": false },
    "SyncContent": { "Disabled": false },
    "HealthCheck": { "Disabled": false },
    "Maintenance": { "Disabled": false },
    "ExportMetadata": { "Disabled": false },
    "MatchDrivers": { "Disabled": false }
  },
  "Features": {
    "EnableScheduledSync": true,
    "EnableContentSync": true,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableDriverMatching": true,
    "ReindexOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Service": {
    "ServiceUrl": "https://your-app.azurewebsites.net",
    "MaxUpdateCount": 10000,
    "SupportedCategories": [
      "Security Updates",
      "Critical Updates",
      "Feature Packs",
      "Updates",
      "Drivers"
    ]
  },
  "Storage": {
    "UseAzureStorage": true,
    "MetadataStorePath": "./store",
    "ContentStorePath": "./content",
    "MetadataContainerName": "metadata",
    "ContentContainerName": "content"
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 6,
    "ComprehensiveUpdatesIntervalHours": 24,
    "ContentSyncIntervalHours": 168,
    "MaintenanceIntervalHours": 168,
    "HealthCheckIntervalMinutes": 15
  }
}
