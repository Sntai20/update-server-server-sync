    "Features": {
        "EnableContentSync": true,
        "EnableDriverMatching": false,
        "EnableHealthMonitoring": false,
        "EnableMetadataExport": false,
        "EnableScheduledSync": false,
        "ReindexOnStartup": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Service": {
        "MaxUpdateCount": 10,
        "ServiceUrl": "http://localhost:7071",
        "SupportedCategories": [
            "Security Updates",
            "Critical Updates"
        ]
    },
    "Storage": {
        "ContentContainerName": "test-data",
        "ContentStorePath": "./test-content",
        "MetadataContainerName": "test-data",
        "MetadataStorePath": "./test-store",
        "UseAzureStorageForMetadata": true,
        "UseAzureStorageForContent": true
    },
    "Sync": {
        "ComprehensiveUpdatesIntervalHours": 168,
        "ContentSyncIntervalHours": 168,
        "CriticalUpdatesIntervalHours": 24,
        "HealthCheckIntervalMinutes": 60,
        "MaintenanceIntervalHours": 168
    },
    "FunctionSchedules": {
        "HourlyHealthCheckSchedule": "06:00:00",
        "DailyCriticalSyncSchedule": "6.00:00:00",
        "WeeklyComprehensiveSyncSchedule": "14.00:00:00",
        "MonthlyMaintenanceSchedule": "30.00:00:00",
        "ScheduledHealthCheckSchedule": "06:00:00",
        "WeeklyMaintenanceSchedule": "14.00:00:00",
        "ScheduledMetadataSyncSchedule": "6.00:00:00",
        "CriticalMetadataSyncSchedule": "12:00:00",
        "ScheduledContentSyncSchedule": "14.00:00:00"
