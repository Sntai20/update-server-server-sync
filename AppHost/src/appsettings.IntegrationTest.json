{
  "UpdateServer": {
    "ServiceUrl": "http://localhost:7071",
    "ContentUrl": "http://localhost:7071/api/content",
    "MaxUpdateCount": 10,
    "SupportedCategories": ["Security Updates", "Critical Updates"]
  },
  "Storage": {
    "MetadataPath": "./test-store",
    "ContentPath": "./test-content",
    "UseAzureStorageForMetadata": true,
    "UseAzureStorageForContent": true,
    "MetadataContainerName": "test-data",
    "ContentContainerName": "test-data",
    "ContentPathPrefix": "Content",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "12:00:00",
    "SyncComprehensive": "6.00:00:00",
    "SyncContent": "14.00:00:00",
    "HealthCheck": "06:00:00",
    "WeeklyMaintenance": "14.00:00:00"
  },
  "AzureWebJobs": {
    // === CORE FUNCTIONS (ENABLED FOR TESTING) ===
    "UniversalSync": {
      "Disabled": false
    },
    "UniversalHealth": {
      "Disabled": false
    },
    "QueryContentStatus": {
      "Disabled": false
    },
    "CheckReindexRequired": {
      "Disabled": false
    },
    "StoreManagement": {
      "Disabled": false
    },
    
    // === SCHEDULED FUNCTIONS (DISABLED FOR TESTING) ===
    "SyncCritical": {
      "Disabled": true
    },
    "SyncComprehensive": {
      "Disabled": true
    },
    "SyncContent": {
      "Disabled": true
    },
    "ScheduledHealthCheck": {
      "Disabled": true
    },
    "WeeklyMaintenance": {
      "Disabled": true
    },

    // === QUERY FUNCTIONS (ENABLED) ===
    "QueryAvailableFilters": {
      "Disabled": false
    },
    "QueryMetadata": {
      "Disabled": false
    },
    "QueryMetadataStoreStatus": {
      "Disabled": false
    },
    "StorageDiagnostics": {
      "Disabled": false
    },

    // === SOAP SERVICES (MINIMAL ENABLEMENT) ===
    "ClientWebService": {
      "Disabled": false
    },
    "DssAuthWebService": {
      "Disabled": true
    },
    "ServerSyncWebService": {
      "Disabled": true
    },
    "SimpleAuthWebService": {
      "Disabled": true
    },
    "ReportingWebService": {
      "Disabled": true
    },

    // === DISABLED FOR TESTING ===
    "ExportMetadata": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContent": {
      "Disabled": true
    },
    "GetMicrosoftUpdateContentHead": {
      "Disabled": true
    },
    "MatchDrivers": {
      "Disabled": true
    },
    "ProcessContentSyncRequest": {
      "Disabled": true
    },
    "ProcessPrioritySyncRequest": {
      "Disabled": true
    },
    "ProcessStandardSyncRequest": {
      "Disabled": true
    },
    "ProcessUniversalSyncRequest": {
      "Disabled": true
    },
    "ScheduledSyncFull": {
      "Disabled": true
    }
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": false,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableScheduledSync": false,
    "ReindexOnStartup": false
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 24,
    "ComprehensiveUpdatesIntervalHours": 168,
    "ContentSyncIntervalHours": 168,
    "HealthCheckIntervalMinutes": 60,
    "MaintenanceIntervalHours": 168
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
