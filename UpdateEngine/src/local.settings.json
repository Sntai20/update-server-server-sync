{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AzureWebJobsSecretStorageType": "files",
    
    // Development: Use empty string to let Aspire provide the storage connection
    "AzureWebJobsStorage": ""
  },
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "http://localhost:7071",
      "ContentUrl": "http://localhost:7071/api/content",
      "MaxUpdateCount": 5,
      "SupportedCategories": [
        "Security Updates",
        "Critical Updates",
        "Definition Updates"
      ],
      "SupportedLanguages": [
        "en",
        "en-US",
        "neutral",
        ""
      ]
    },
    "StorageConfiguration": {
      "MetadataPath": "./LocalMetadataStore",
      "ContentPath": "./LocalContentStore",
      "UseAzureStorageForMetadata": true,
      "UseAzureStorageForContent": true,
      "MetadataContainerName": "data",
      "ContentContainerName": "data",
      "ContentPathPrefix": "Content",
      "ReindexOnStartup": true
    },
    "SyncConfiguration": {
      "SyncCriticalSchedule": "0 */2 * * * *",
      "SyncComprehensiveSchedule": "0 */5 * * * *",
      "SyncContentSchedule": "0 */3 * * * *",
      "ScheduledHealthCheckSchedule": "0 */1 * * * *",
      "MaintenanceSchedule": "14.00:00:00",
      "AnomalyDetectionSchedule": "0 */2 * * * *",
      "EnableScheduledSync": true
    },
    "FeatureFlags": {
      "EnableDetailedLogging": false,
      "EnableMetrics": true,
      "EnableCaching": true
    },
    "CacheConfiguration": {
      "EnableDistributedCache": false,
      "KeyPrefix": "msupdate:",
      "DefaultExpirationMinutes": 60,
      "StatisticsCacheMinutes": 5,
      "UpdateDetailsCacheMinutes": 60,
      "ContentAvailabilityCacheMinutes": 15,
      "InvalidateOnSync": true
    }
  }
}
