{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AzureWebJobsSecretStorageType": "files",
    
    // Development: Empty means use AppHost/Aspire provided storage
    "AzureWebJobsStorage": ""
  },
  "UpdateServer": {
    "ServiceUrl": "http://localhost:7071",
    "ContentUrl": "http://localhost:7071/api/content",
    "MaxUpdateCount": 100,
    "SupportedCategories": ["Security Updates", "Critical Updates"]
  },
  "Storage": {
    "MetadataPath": "../../store",
    "ContentPath": "../../content",
    "UseAzureStorageForMetadata": false,
    "UseAzureStorageForContent": false,
    "MetadataContainerName": "data",
    "ContentContainerName": "data",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "00:02:00",
    "SyncComprehensive": "00:05:00",
    "SyncContent": "00:03:00",
    "HealthCheck": "00:01:00",
    "WeeklyMaintenance": "14.00:00:00",
    "AnomalyDetection": "00:02:00"
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": false,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": false,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false,
    "EnableAnomalyDetection": true
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 2,
    "ComprehensiveUpdatesIntervalHours": 5,
    "ContentSyncIntervalHours": 3,
    "HealthCheckIntervalMinutes": 1,
    "MaintenanceIntervalHours": 336,
    "AnomalyDetectionIntervalMinutes": 2
  }
}
