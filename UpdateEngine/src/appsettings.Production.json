{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine": "Information",
      "Microsoft.PackageGraph": "Information"
    }
  },
  "Storage": {
    // Production defaults to Azure Storage
    "UseLocalStorageForMetadata": false,
    "UseLocalStorageForContent": false,
    "DisableContentStore": false,
    "MetadataContainerName": "metadata", 
    "ContentContainerName": "content"
  },
  "Service": {
    "ServiceUrl": "https://your-update-server.azurewebsites.net",
    "SupportsContentDownload": true,
    "MaxUpdateCount": 10000,
    "SupportedCategories": [
      "Security Updates",
      "Critical Updates", 
      "Updates",
      "Update Rollups",
      "Service Packs"
    ]
  },
  "FunctionSchedules": {
    // Production schedules - optimized for efficiency over speed
    "SyncMetadataCriticalSchedule": "02:00:00",        // Every 2 hours
    "SyncMetadataComprehensiveSchedule": "6.00:00:00", // Every 6 hours
    "SyncContentSchedule": "3.00:00:00",               // Every 3 hours  
    "ScheduledHealthCheckSchedule": "00:15:00",        // Every 15 minutes
    "AnomalyDetectionSchedule": "01:00:00"             // Every hour
  },
  "Content": {
    "HttpRoot": "https://your-update-server.azurewebsites.net/api/content/"
  }
}