{
  "UpdateServer": {
    "ServiceUrl": "https://your-update-server.azurewebsites.net",
    "ContentUrl": "https://your-update-server.azurewebsites.net/api/content",
    "MaxUpdateCount": 10000,
    "SupportedCategories": [
      "Security Updates",
      "Critical Updates", 
      "Updates",
      "Update Rollups",
      "Service Packs"
    ]
  },
  "Storage": {
    "MetadataPath": "",
    "ContentPath": "",
    "UseAzureStorageForMetadata": true,
    "UseAzureStorageForContent": true,
    "MetadataContainerName": "metadata",
    "ContentContainerName": "content",
    "ReindexOnStartup": false
  },
  "FunctionSchedules": {
    "SyncCritical": "02:00:00",
    "SyncComprehensive": "6.00:00:00",
    "SyncContent": "3.00:00:00",
    "HealthCheck": "00:15:00",
    "WeeklyMaintenance": "7.00:00:00",
    "AnomalyDetection": "01:00:00"
  },
  "Features": {
    "EnableContentSync": true,
    "EnableDriverMatching": true,
    "EnableHealthMonitoring": true,
    "EnableMetadataExport": true,
    "EnableScheduledSync": true,
    "ReindexOnStartup": false,
    "EnableAnomalyDetection": true
  },
  "Sync": {
    "CriticalUpdatesIntervalHours": 2,
    "ComprehensiveUpdatesIntervalHours": 6,
    "ContentSyncIntervalHours": 3,
    "HealthCheckIntervalMinutes": 15,
    "MaintenanceIntervalHours": 168
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine": "Information",
      "Microsoft.PackageGraph": "Information"
    }
  }
}