{
  "_comment": "Shared Development Configuration - Team-wide development settings. Optimized for RAPID iteration with frequent sync cycles. Overrides defaults.",
  
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "http://localhost:7071",
      "ContentUrl": "http://localhost:7071/api/content",
      "UpstreamServerUrl": "https://fe2.update.microsoft.com/v6/windowsupdate/Services/",
      "MaxConcurrentSyncs": 5,
      "RequestTimeoutSeconds": 300,
      "MaxUpdateCount": 5,
      "SupportedCategories": [
        "Security Updates",
        "Critical Updates",
        "Definition Updates"
      ],
      "SupportedLanguages": [
        "en",
        "en-US",
        "neutral",
        ""
      ]
    },
    "StorageConfiguration": {
      "_comment": "Azure Functions uses Azure Storage (Azurite). WorkerService overrides these in its own appsettings.Development.json to use filesystem.",
      "UseAzureStorageForMetadata": true,
      "UseAzureStorageForContent": true,
      "MetadataContainerName": "data",
      "ContentContainerName": "data",
      "ReindexOnStartup": true
    },
    "SyncConfiguration": {
      "_comment": "Fast development schedules - Critical every 3min, Comprehensive/Content every 5min staggered, Health every 2min, Anomaly every 1min",
      "SyncCriticalSchedule": "0 */3 * * * *",
      "SyncComprehensiveSchedule": "0 1,6,11,16,21,26,31,36,41,46,51,56 * * * *",
      "SyncContentSchedule": "0 3,8,13,18,23,28,33,38,43,48,53,58 * * * *",
      "ScheduledHealthCheckSchedule": "0 */2 * * * *",
      "MaintenanceSchedule": "0 0 */2 * * *",
      "AnomalyDetectionSchedule": "0 * * * * *",
      "EnableScheduledSync": true
    },
    "CacheConfiguration": {
      "EnableDistributedCache": false,
      "RedisConnectionString": "localhost:6379",
      "KeyPrefix": "updateengine:dev:",
      "DefaultExpirationMinutes": 30,
      "StatisticsCacheMinutes": 5,
      "UpdateDetailsCacheMinutes": 60,
      "ContentAvailabilityCacheMinutes": 15,
      "InvalidateOnSync": true
    },
    "FeatureFlags": {
      "EnableEmergencySync": true,
      "EnableComprehensiveSync": true,
      "EnableContentSync": true,
      "EnableAnomalyDetection": true,
      "EnableDeepHealthCheck": true,
      "EnableMaintenance": true,
      "EnableDetailedLogging": true,
      "EnableMetrics": false,
      "EnableOpenTelemetry": false,
      "EnableCaching": false,
      "EnableCompression": true,
      "EnableExperimentalFeatures": false
    },
    "DownstreamConfiguration": {
      "_comment": "Development: WorkerService pulls from Functions using Aspire service discovery. Enabled by default for downstream testing. WorkerService can override SyncFromUpstream=false to disable.",
      "UpstreamFunctionsUrl": "http://UpdateEngine",
      "SyncFromUpstream": true,
      "SyncIntervalMinutes": 15,
      "EnableContentSync": true,
      "HttpTimeout": "00:10:00",
      "MaxRetries": 3,
      "RetryDelay": "00:00:30"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.PackageGraph": "Debug",
      "UpdateEngine.Services": "Debug",
      "UpdateEngine.Core.Services.AnomalyDetectionService": "Debug",
      "UpdateEngine.Core.Services.SyncService": "Debug"
    }
  }
}