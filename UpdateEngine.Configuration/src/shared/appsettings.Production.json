{
  "_comment": "Shared Production Configuration - Production-grade settings for all projects. Replace placeholder values with actual Azure resources. Overrides defaults and development.",
  
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "https://your-update-server.azurewebsites.net",
      "ContentUrl": "https://your-update-server.azurewebsites.net/api/content",
      "UpstreamServerUrl": "https://fe2.update.microsoft.com/v6/windowsupdate/Services/",
      "MaxConcurrentSyncs": 10,
      "RequestTimeoutSeconds": 600,
      "MaxUpdateCount": 10000,
      "SupportedCategories": [
        "Critical Updates",
        "Security Updates",
        "Updates",
        "Update Rollups",
        "Service Packs",
        "Definition Updates"
      ],
      "SupportedLanguages": [
        "en",
        "en-US",
        "de",
        "de-DE",
        "es",
        "es-ES",
        "fr",
        "fr-FR",
        "ja",
        "ja-JP",
        "neutral",
        ""
      ]
    },
    "StorageConfiguration": {
      "UseAzureStorageForMetadata": true,
      "UseAzureStorageForContent": true,
      "MetadataContainerName": "metadata",
      "ContentContainerName": "content",
      "ContentPathPrefix": "Content",
      "ReindexOnStartup": false
    },
    "SyncConfiguration": {
      "SyncCriticalSchedule": "0 0 */6 * * *",
      "SyncComprehensiveSchedule": "0 0 2 * * *",
      "SyncContentSchedule": "0 0 1 * * *",
      "ScheduledHealthCheckSchedule": "0 */5 * * * *",
      "MaintenanceSchedule": "0 0 3 */7 * *",
      "AnomalyDetectionSchedule": "0 0 */2 * * *",
      "EnableScheduledSync": true
    },
    "CacheConfiguration": {
      "EnableDistributedCache": true,
      "RedisConnectionString": "",
      "KeyPrefix": "updateengine:prod:",
      "DefaultExpirationMinutes": 60,
      "StatisticsCacheMinutes": 10,
      "UpdateDetailsCacheMinutes": 120,
      "ContentAvailabilityCacheMinutes": 30,
      "InvalidateOnSync": true
    },
    "FeatureFlags": {
      "EnableEmergencySync": true,
      "EnableComprehensiveSync": true,
      "EnableContentSync": true,
      "EnableAnomalyDetection": true,
      "EnableDeepHealthCheck": false,
      "EnableMaintenance": true,
      "EnableDetailedLogging": false,
      "EnableMetrics": true,
      "EnableOpenTelemetry": true,
      "EnableCaching": true,
      "EnableCompression": true,
      "EnableExperimentalFeatures": false
    }
  },
  "AnomalyDetection": {
    "_comment": "Production ML.NET anomaly detection - Higher threshold to reduce false positives, separate storage account for model and queue",
    "ModelPath": "./anomaly-model.zip",
    "AnomalyScoreThreshold": 0.90,
    "QueueName": "anomaly-events-prod"
  },
  "Features": {
    "_comment": "Production feature flags - Anomaly detection enabled for security monitoring",
    "EnableAnomalyDetection": true
  },
  "ConnectionStrings": {
    "MetadataStorageConnection": "DefaultEndpointsProtocol=https;AccountName=myupdateserver;AccountKey=<KEY>;EndpointSuffix=core.windows.net",
    "ContentStorageConnection": "DefaultEndpointsProtocol=https;AccountName=myupdatecontent;AccountKey=<KEY>;EndpointSuffix=core.windows.net",
    "RedisConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UpdateEngine.Core.Services.AnomalyDetectionService": "Information"
    }
  }
}