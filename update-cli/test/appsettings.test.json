{
  "CliMode": "local",
  "UpdateEngine": {
    "StorageConfiguration": {
      "MetadataPath": "./TestData/metadata",
      "ContentPath": "./TestData/content",
      "Provider": "FileSystem"
    },
    "SyncConfiguration": {
      "EnableAutoSync": false,
      "SyncIntervalMinutes": 0,
      "MaxConcurrentSyncs": 1,
      "RetryAttempts": 1,
      "RetryDelaySeconds": 1
    },
    "CacheConfiguration": {
      "EnableCache": false,
      "DefaultCacheDurationMinutes": 5
    },
    "FeatureFlags": {
      "EnableContentDownload": true,
      "EnableMetadataSync": true,
      "EnableHealthChecks": true,
      "EnableMetrics": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
