{
  "ServiceUrl": "http://localhost:7071",
  "ContentUrl": "http://localhost:7071/api/content",
  "MaxUpdateCount": 1000,
  "SupportedCategories": [
    "Critical Updates",
    "Security Updates",
    "Updates",
    "Update Rollups",
    "Service Packs",
    "Feature Packs",
    "Tools",
    "Drivers",
    "Definition Updates",
    "Developer Kits",
    "Guidance",
    "Upgrades",
    "Applications",
    "Connectors"
  ],
  "SupportedLanguages": [ "en", "en-US", "neutral", "" ],

  "MetadataPath": "./LocalMetadataStore",
  "ContentPath": "./LocalContentStore",
  "UseAzureStorageForMetadata": true,
  "UseAzureStorageForContent": true,
  "MetadataContainerName": "data",
  "ContentContainerName": "data",
  "ContentPathPrefix": "Content",
  "ReindexOnStartup": false,

  "SyncCriticalSchedule": "0 */2 * * * *",
  "SyncComprehensiveSchedule": "0 0 */1 * * *",
  "SyncContentSchedule": "0 0 0 */1 * *",
  "ScheduledHealthCheckSchedule": "0 */15 * * * *",
  "MaintenanceSchedule": "0 0 2 */7 * *",
  "WeeklyMaintenanceSchedule": "0 0 3 */7 * *",
  "AnomalyDetectionSchedule": "0 0 */1 * * *",

  "EnableScheduledSync": true,
  "EnableDetailedLogging": false,
  "EnableMetrics": true,
  "EnableCaching": true,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}