{
  "MaxUpdateCount": 5,
  "SupportedCategories": [ 
    "Security Updates",
    "Critical Updates",
    "Definition Updates"
    ],

  "ReindexOnStartup": true,

  "SyncCriticalSchedule": "0 */1 * * * *",
  "SyncComprehensiveSchedule": "0 */2 * * * *",
  "SyncContentSchedule": "0 */3 * * * *",
  "ScheduledHealthCheckSchedule": "0 */1 * * * *",
  "MaintenanceSchedule": "0 */5 * * * *",
  "AnomalyDetectionSchedule": "0 */2 * * * *",

  "EnableScheduledSync": true,
  "EnableDetailedLogging": true,
  "EnableMetrics": false,
  "EnableCaching": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.PackageGraph": "Debug",
      "UpdateEngine.Services": "Debug"
    }
  }
}