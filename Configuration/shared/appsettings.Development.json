{
  "MaxUpdateCount": 5,
  "SupportedCategories": ["Security Updates", "Critical Updates", "Definition Updates"],
  
  "MetadataPath": "./dev-store",
  "ContentPath": "./dev-content",
  "MetadataContainerName": "dev-metadata",
  "ContentContainerName": "dev-content",
  "ReindexOnStartup": true,

  "SyncCriticalSchedule": "0 */30 * * * *",
  "SyncComprehensiveSchedule": "0 */2 * * * *",
  "SyncContentSchedule": "0 */1 * * * *",
  "ScheduledHealthCheckSchedule": "0 */15 * * * *",
  "MaintenanceSchedule": "0 0 2 */14 * *",
  "AnomalyDetectionSchedule": "0 */30 * * * *",

  "EnableScheduledSync": false,
  "EnableDetailedLogging": true,
  "EnableMetrics": false,
  "EnableCaching": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.PackageGraph": "Debug",
      "UpdateEngine.Services": "Debug"
    }
  }
}