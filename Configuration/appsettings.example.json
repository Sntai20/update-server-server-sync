{
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "http://localhost:7071",
      "ContentUrl": "http://localhost:7071/api/content",
      "UpstreamServerUrl": "https://fe2.update.microsoft.com/v6/windowsupdate/Services/",
      "MaxConcurrentSyncs": 5,
      "RequestTimeoutSeconds": 300,
      "MaxUpdateCount": 1000,
      "SupportedCategories": [
        "Security Updates",
        "Critical Updates",
        "Updates"
      ],
      "SupportedLanguages": [
        "en",
        "en-US",
        "neutral",
        ""
      ]
    },
    "SyncConfiguration": {
      "SyncIntervalMinutes": 60,
      "EmergencySyncIntervalMinutes": 15,
      "HealthCheckIntervalMinutes": 5,
      "MaintenanceIntervalHours": 168,
      "DeepHealthCheckIntervalHours": 24,
      "AnomalyDetectionCooldownMinutes": 30,
      "ContentSyncBatchSize": 50,
      "MetadataQueryBatchSize": 100,
      "SyncCriticalSchedule": "0 */2 * * * *",
      "SyncComprehensiveSchedule": "0 0 */1 * * *",
      "SyncContentSchedule": "0 0 0 */1 * *",
      "ScheduledHealthCheckSchedule": "0 */15 * * * *",
      "MaintenanceSchedule": "0 0 2 */7 * *",
      "AnomalyDetectionSchedule": "0 0 */1 * * *",
      "EnableScheduledSync": true,
      "EnableEmergencySync": true
    },
    "StorageConfiguration": {
      "MetadataPath": "./LocalMetadataStore",
      "ContentPath": "./LocalContentStore",
      "UseAzureStorageForMetadata": false,
      "UseAzureStorageForContent": false,
      "AzureStorageConnectionString": "",
      "AzureStorageAccountName": "",
      "MetadataContainerName": "metadata",
      "ContentContainerName": "content",
      "ReportsContainerName": "reports",
      "ContentPathPrefix": "Content",
      "ReindexOnStartup": false
    },
    "FeatureFlags": {
      "EnableEmergencySync": true,
      "EnableComprehensiveSync": true,
      "EnableContentSync": true,
      "EnableAnomalyDetection": false,
      "EnableDeepHealthCheck": true,
      "EnableMaintenance": true,
      "EnableDetailedLogging": false,
      "EnableMetrics": true,
      "EnableOpenTelemetry": true,
      "EnableCaching": true,
      "EnableCompression": true,
      "EnableExperimentalFeatures": false
    }
  }
}
