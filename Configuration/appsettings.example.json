{
  "UpdateEngine": {
    "ServiceConfiguration": {
      "ServiceUrl": "http://localhost:7071",
      "ContentUrl": "http://localhost:7071/api/content",
      "UpstreamServerUrl": "https://fe2.update.microsoft.com/v6/windowsupdate/Services/",
      "MaxConcurrentSyncs": 5,
      "RequestTimeoutSeconds": 300,
      "MaxUpdateCount": 1000,
      "SupportedCategories": [
        "Security Updates",
        "Critical Updates",
        "Updates"
      ],
      "SupportedLanguages": [
        "en",
        "en-US",
        "neutral",
        ""
      ]
    },
    "SyncConfiguration": {
      "SyncIntervalMinutes": 60,
      "EmergencySyncIntervalMinutes": 15,
      "HealthCheckIntervalMinutes": 5,
      "MaintenanceIntervalHours": 168,
      "DeepHealthCheckIntervalHours": 24,
      "AnomalyDetectionCooldownMinutes": 30,
      "ContentSyncBatchSize": 50,
      "MetadataQueryBatchSize": 100,
      "SyncCriticalSchedule": "0 */2 * * * *",
      "SyncComprehensiveSchedule": "0 0 */1 * * *",
      "SyncContentSchedule": "0 0 0 */1 * *",
      "ScheduledHealthCheckSchedule": "0 */15 * * * *",
      "MaintenanceSchedule": "0 0 2 */7 * *",
      "AnomalyDetectionSchedule": "0 0 */1 * * *",
      "EnableScheduledSync": true,
      "EnableEmergencySync": true
    },
    "StorageConfiguration": {
      "MetadataPath": "./LocalMetadataStore",
      "ContentPath": "./LocalContentStore",
      "UseAzureStorageForMetadata": false,
      "UseAzureStorageForContent": false,
      "AzureStorageConnectionString": "",
      "AzureStorageAccountName": "",
      "MetadataContainerName": "metadata",
      "ContentContainerName": "content",
      "ReportsContainerName": "reports",
      "ContentPathPrefix": "Content",
      "ReindexOnStartup": false
    },
    "CacheConfiguration": {
      "EnableDistributedCache": false,
      "KeyPrefix": "msupdate:",
      "DefaultExpirationMinutes": 60,
      "StatisticsCacheMinutes": 5,
      "UpdateDetailsCacheMinutes": 60,
      "ContentAvailabilityCacheMinutes": 15,
      "InvalidateOnSync": true
    },
    "FeatureFlags": {
      "EnableEmergencySync": true,
      "EnableComprehensiveSync": true,
      "EnableContentSync": true,
      "EnableAnomalyDetection": false,
      "EnableDeepHealthCheck": true,
      "EnableMaintenance": true,
      "EnableDetailedLogging": false,
      "EnableMetrics": true,
      "EnableOpenTelemetry": true,
      "EnableCaching": true,
      "EnableCompression": true,
      "EnableExperimentalFeatures": false
    }
  },
  "ConnectionStrings": {
    "RedisConnection": "localhost:6379"
  },
  "Comments": {
    "CacheConfiguration": {
      "EnableDistributedCache": "Set to true to enable Redis-backed caching. Requires RedisConnection in ConnectionStrings.",
      "KeyPrefix": "Prefix for all cache keys to avoid collisions with other applications using the same Redis instance.",
      "DefaultExpirationMinutes": "Default TTL (time-to-live) for cached items when not specified explicitly.",
      "StatisticsCacheMinutes": "TTL for metadata and content statistics (5 min recommended for frequently changing data).",
      "UpdateDetailsCacheMinutes": "TTL for individual update package details (60 min recommended for stable data).",
      "ContentAvailabilityCacheMinutes": "TTL for content availability checks (15 min recommended for balance).",
      "InvalidateOnSync": "Automatically invalidate all caches after successful sync operations."
    },
    "ConnectionStrings": {
      "RedisConnection": "Redis connection string. For local development: 'localhost:6379'. For Azure Cache for Redis: '<name>.redis.cache.windows.net:6380,password=<key>,ssl=True'"
    }
  }
}
